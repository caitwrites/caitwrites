# Frontend: static builds leave this false. Set true only for the Cloudflare fallback.
VITE_USE_API=false
VITE_CANONICAL_URL=https://caitwrites.co.za

# Static Google Sheets sync. GitHub Actions uses GOOGLE_SERVICE_ACCOUNT_JSON.
# Local development can instead use GOOGLE_APPLICATION_CREDENTIALS; when omitted,
# scripts default to %USERPROFILE%\.secrets\caitwrites-service-account.json.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=10_-eQ_659xyk6ccyl4hLpT--VxaYHVvd1uRADHj68A8
GOOGLE_SHEET_RANGE=Combined!A:K
METADATA_REFRESH_LIMIT=8
MIN_PORTFOLIO_RECORDS=200
EXPECTED_FAVOURITES=8

# Cloudflare Worker fallback secrets (set with `wrangler secret put`).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SYNC_SECRET=

# Non-secret Worker variables are configured in wrangler.toml.
